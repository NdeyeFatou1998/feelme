PORT=4000
DATABASE_URL=
# Long et aléatoire (ex. : openssl rand -hex 32). Sans lui, les sessions admin sautent à chaque redémarrage.
JWT_SECRET=
# Mot de passe du premier admin créé par /api/seed (12 caractères au moins). Inutile une fois l'admin créé.
SEED_ADMIN_PASSWORD=
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
PAYTECH_ENV=test
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Feel Me <email>
API_URL=https://your-backend.up.railway.app
FRONT_URL=https://feelme-six.vercel.app
CORS_ORIGIN=https://feelme-six.vercel.app

# AJA (ajaflow.com) — créée par `npx @ajaflow/sdk connect <CODE>`, serveur de production uniquement
AJA_KEY=
